{
  "name": "[TEST] COMMAX Wallpad (EW11)",
  "version": "1.3.0",
  "slug": "commax_test",
  "url": "https://github.com/cwygp1/HaIot",
  "description": "mqtt 통신을 활용한 코맥스 월패드 컨트롤러 (EW11 MQTT 모드)",
  "arch": ["armv7", "aarch64", "amd64", "i386"],
  "map": [
    "share:rw"
  ],
  "startup": "application",
  "boot": "auto",
  "options": {
    "DEBUG": false,
    "mqtt_log": true,
    "elfin_log": false,
    "raw_log_minutes": 10,
    "mqtt_server": "",
    "mqtt_port": 1883,
    "mqtt_id": "",
    "mqtt_password": "",
    "elfin_server": "",
    "elfin_id": "admin",
    "elfin_password": "",
    "send_gap_ms": 60,
    "send_window_ms": 70,
    "poll_wait_ms": 60,
    "ack_wait_ms": 120,
    "retry_interval_ms": 150,
    "max_retry": 5,
    "cmd_ttl_sec": 10,
    "tx_enable": true,
    "max_tx_per_min": 120,
    "scan_seconds": 20,
    "ew11_restart_after_sec": 60,
    "ew11_restart_min_interval_sec": 300,
    "bus_master": "auto",
    "master_after_sec": 10,
    "master_interval_ms": 150,
    "diag_interval_sec": 60,
    "purge_discovery": false
  },
  "schema": {
    "DEBUG": "bool",
    "mqtt_log": "bool",
    "elfin_log": "bool",
    "raw_log_minutes": "int(1,1440)?",
    "mqtt_server": "str",
    "mqtt_port": "int(1,65535)?",
    "mqtt_id": "str",
    "mqtt_password": "password",
    "elfin_server": "str?",
    "elfin_id": "str?",
    "elfin_password": "password?",
    "send_gap_ms": "int(5,500)?",
    "send_window_ms": "int(10,500)?",
    "poll_wait_ms": "int(0,500)?",
    "ack_wait_ms": "int(20,2000)?",
    "retry_interval_ms": "int(50,5000)?",
    "max_retry": "int(1,20)?",
    "cmd_ttl_sec": "int(1,120)?",
    "tx_enable": "bool?",
    "max_tx_per_min": "int(1,600)?",
    "scan_seconds": "int(5,120)?",
    "ew11_restart_after_sec": "int(10,3600)?",
    "ew11_restart_min_interval_sec": "int(30,86400)?",
    "bus_master": "list(auto|on|off)?",
    "master_after_sec": "int(3,600)?",
    "master_interval_ms": "int(50,2000)?",
    "diag_interval_sec": "int(10,3600)?",
    "purge_discovery": "bool?"
  }
}
